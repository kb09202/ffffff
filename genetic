def crossover(parent1, parent2):
    size = len(parent1)
    a, b = sorted(random.sample(range(size), 2))
    child = [None]*size
    child[a:b] = parent1[a:b]
    ptr = 0
    for gene in parent2:
        if gene not in child:
            while child[ptr] is not None:
                ptr += 1
            child[ptr] = gene
    return child

def mutate(path, prob=0.1):
    for i in range(len(path)):
        if random.random() < prob:
            j = random.randint(0, len(path)-1)
            path[i], path[j] = path[j], path[i]

def genetic_tsp(points, population_size=50, generations=100):
    n = len(points)
    population = [random.sample(range(n), n) for _ in range(population_size)]

    def fitness(path):
        return 1 / tsp_cost(path, points)

    for _ in range(generations):
        population.sort(key=fitness, reverse=True)
        new_population = population[:2]  # élites
        while len(new_population) < population_size:
            p1, p2 = random.sample(population[:20], 2)
            child = crossover(p1, p2)
            mutate(child)
            new_population.append(child)
        population = new_population

    best = max(population, key=fitness)
    return best, tsp_cost(best, points)

# Exemple
points = [(random.random()*100, random.random()*100) for _ in range(10)]
path, cost = genetic_tsp(points)
print("Chemin GA:", path, "Coût =", round(cost,2))